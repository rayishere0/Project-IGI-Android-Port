<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      NoActionBar base: Capacitor bridges need this; we layer immersive mode
      on top in MainActivity.applyImmersiveMode().
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- IGI dark colour palette -->
        <item name="colorPrimary">#0a0c08</item>
        <item name="colorPrimaryDark">#0a0c08</item>
        <item name="colorAccent">#4a7c2a</item>
        <!-- Remove window title bar -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- Full screen layout -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Background while loading -->
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <!-- Alias used in AndroidManifest; keeps the same base -->
    <style name="AppTheme.NoActionBar" parent="AppTheme" />

</resources>

