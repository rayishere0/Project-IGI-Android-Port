<?xml version="1.0" encoding="utf-8"?>
<!-- Night-mode values: identical dark theme (the game is always dark) -->
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0a0c08</item>
        <item name="colorPrimaryDark">#0a0c08</item>
        <item name="colorAccent">#4a7c2a</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme" />
</resources>

