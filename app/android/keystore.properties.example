# Release signing credentials for the Android app.
# Copy this file to keystore.properties in the same directory (app/android/)
# and fill in the real values. NEVER commit keystore.properties or the
# .keystore file itself — both are gitignored and stay on the build machine.
#
# storeFile: path to the release keystore, relative to app/android/.
#   Create it once with:
#     keytool -genkeypair -v -keystore projectigi-release.keystore -alias projectigi -keyalg RSA -keysize 2048 -validity 10000
#   (keytool ships with the JDK / Android Studio.) It will ask for a keystore
#   password and a key password — use strong ones and save them somewhere safe.
# keyAlias: the alias given to keytool above.
storeFile=projectigi-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=projectigi
keyPassword=YOUR_KEY_PASSWORD
