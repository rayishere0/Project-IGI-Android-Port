<Project>

  <!-- Central Package Management: all package versions live here, never in .csproj files. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <!-- Keeps logging in one place: raw Console, Debug.WriteLine and Trace use fails the build (BannedSymbols.txt). -->
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Silk.NET">
    <PackageVersion Include="Silk.NET.Core" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Input" Version="2.22.0" />
    <!-- Vulkan backend. The core loader plus the KHR extensions (surface, swapchain, and the
         ray-tracing/acceleration-structure set the hardware-RT GI path needs) and the EXT extensions
         (debug utils). Nothing compiles or reflects a shader here: ProjectIGI.Shaders compiles every
         module to SPIR-V at build time and commits the reflection beside it. -->
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.22.0" />
    <!-- Vulkan on macOS is MoltenVK translating to Metal, and there is no system loader to find it:
         Apple ships no Vulkan. Silk's loader looks for libvulkan.dylib and then libMoltenVK.dylib, and
         checks the application's own directory, so shipping the dylib beside the executable is the whole
         of the installation. The package carries osx-arm64 and osx-x64 natives and nothing else, so it
         adds no bytes to a Windows or Linux publish.

         Ahead of the other Silk packages on purpose. 2.22.0 carries MoltenVK 1.2.12, which is a Vulkan 1.2
         implementation, and the render path needs dynamic rendering as Vulkan 1.3 core; on that loader the
         game stopped at device creation. 2.23.0 carries MoltenVK 1.4, and the package is natives only, with
         no managed dependency to hold in step with the rest. -->
    <PackageVersion Include="Silk.NET.MoltenVK.Native" Version="2.23.0" />
    <!-- Direct3D 12 and DXGI, the same Silk.NET release as the rest. The runtime itself is the Agility SDK's
         D3D12Core.dll, which ProjectIGI.Rendering.D3D12 copies into <app>/D3D12/ and loads through the device
         factory: a managed apphost cannot export D3D12SDKVersion, which is how a native exe asks for it. -->
    <PackageVersion Include="Silk.NET.Direct3D12" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.DXGI" Version="2.22.0" />
    <PackageVersion Include="Microsoft.Direct3D.D3D12" Version="1.619.6" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.22.0" />
    <!-- Capture extension (alcCaptureOpenDevice et al.), for the co-op microphone: OpenAlMicrophone
         opens the default capture device through it. Same release as the rest of Silk.NET. -->
    <PackageVersion Include="Silk.NET.OpenAL.Extensions.EXT" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <ItemGroup Label="Source generators">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="User interface">
    <!-- TrueType rasteriser for the SDF font atlas built at startup (R10). A pure-managed port of
         stb_truetype, so it adds no native dependency and runs the same on every platform the port
         targets. -->
    <PackageVersion Include="StbTrueTypeSharp" Version="1.26.12" />
    <!-- BC1/BC7 block compression: encoded by the pack builder, decoded at run time only on an adapter
         that cannot sample block-compressed textures. MIT. -->
    <PackageVersion Include="BCnEncoder.Net" Version="2.3.0" />

    <!-- The launcher's renderer for the shared interface (ProjectIGI.UI.Skia). Skia draws the same widgets
         the game draws through its sprite batch, with real vector text from the same TrueType files. The
         Windows and macOS natives ship inside SkiaSharp; Linux takes the no-dependencies build so the
         launcher runs on a bare distribution without fontconfig. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />

    <!-- The launcher's window is a plain OpenGL surface Skia renders into. -->
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup Label="Sound">
    <!-- I.G.I. 2 ships its menu theme as a 320 kbps MPEG-1 Layer III stream inside
         menusystem/sound/sounds.res, where the first game ships IMA ADPCM; retail decodes it through
         Miles (mss32.dll). NLayer is a pure-managed MIT decoder with no reflection and no native
         dependency, so it behaves the same on every platform the port targets and stays AOT-safe:
         the same reasoning that picked StbTrueTypeSharp above. -->
    <PackageVersion Include="NLayer" Version="3.0.0" />
    <!-- Opus voice codec for co-op, pure managed C# (no native Opus library): GameHost.CoopVoice
         encodes 48 kHz / 20 ms frames through it. Licence is the BSD-style Opus licence (copyright
         Skype Limited, Xiph.Org Foundation, CSIRO, Microsoft, Jean-Marc Valin, Gregory Maxwell,
         Mark Borgerding, Timothy B. Terriberry, Logan Stromberg); its notice is carried verbatim
         in THIRD-PARTY-NOTICES.md, as the licence requires for binary redistribution. -->
    <PackageVersion Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <!-- The harness behind tests/ProjectIGI.Benchmarks. Only that project references it, so it adds
         nothing to a shipped build. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Physics">
    <!-- BepuPhysics 2.4.0 (+ BepuUtilities 2.4.0): the ragdoll prototype's solver. Pure managed,
         no native dependencies; the 2.4.0 assets are net6.0, consumed by the net10.0 project via
         NuGet forward compatibility. Stable only — no beta. -->
    <PackageVersion Include="BepuPhysics" Version="2.4.0" />
    <PackageVersion Include="BepuUtilities" Version="2.4.0" />
  </ItemGroup>

</Project>
