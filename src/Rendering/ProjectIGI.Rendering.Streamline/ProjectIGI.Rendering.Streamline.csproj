<Project Sdk="Microsoft.NET.Sdk">

  <!-- NVIDIA's Streamline, whichever graphics API is underneath: the C ABI mirrored without a native shim,
       the signature check every DLL is held to before anything is loaded, the session from slInit to
       slShutdown, and IRhiStreamline itself: options, constants, tags, evaluation, Reflex and frame
       generation. What differs between Vulkan and Direct3D 12 is small and native, and each backend
       supplies it through IStreamlineGraphicsAdapter: the command list, how a texture is described and put
       into the state its tag names, the barrier around an evaluation, the swapchain and the frame's waits.

       Windows desktop only in practice (Streamline is a Windows SDK), and never referenced by the browser
       build. The ABI types stay internal; the backends that hand Streamline native objects see them. -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ProjectIGI.Core\ProjectIGI.Core.csproj" />
    <ProjectReference Include="..\ProjectIGI.Rendering.Rhi\ProjectIGI.Rendering.Rhi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjectIGI.Rendering.Vulkan" />
    <InternalsVisibleTo Include="ProjectIGI.Rendering.D3D12" />
    <InternalsVisibleTo Include="ProjectIGI.Rendering.Streamline.Tests" />
  </ItemGroup>

</Project>
