<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Project I.G.I.: its data layout, its format profile, the content modules that register its task
         types, script natives and tables, and its gameplay: its soldiers' minds, its player, its doors,
         lifts, pickups and menus. Never references the other title project; only an app composition root
         may name both, and it does so through IGameTitleRuntime. -->
    <ProjectReference Include="..\..\Core\ProjectIGI.Core\ProjectIGI.Core.csproj" />
    <ProjectReference Include="..\..\Engine\ProjectIGI.Engine\ProjectIGI.Engine.csproj" />
    <ProjectReference Include="..\..\Core\ProjectIGI.Formats\ProjectIGI.Formats.csproj" />
    <ProjectReference Include="..\..\Core\ProjectIGI.Scripting\ProjectIGI.Scripting.csproj" />
    <ProjectReference Include="..\ProjectIGI.Game\ProjectIGI.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emits the [ScriptParam] binders for this title's task classes. Build-time only: nothing of it ships. -->
    <ProjectReference Include="..\..\Core\ProjectIGI.Generators\ProjectIGI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepuPhysics: the ragdoll prototype (Physics/BepuRagdoll*.cs). Versions live in
         Directory.Packages.props; both packages are referenced because the adapter uses BepuUtilities
         types directly (BufferPool, Buffer&lt;T&gt;, Symmetric3x3). -->
    <PackageReference Include="BepuPhysics" />
    <PackageReference Include="BepuUtilities" />
  </ItemGroup>

</Project>
