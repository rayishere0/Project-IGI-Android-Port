<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Opus voice codec for co-op (pure managed; see Directory.Packages.props for the licence note). -->
    <PackageReference Include="Concentus" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game host: the frame loop, the mission and cutscene wiring, the developer console, the
         menu host and the bake orchestration. Everything here is portable — a desktop, mobile or web
         app supplies the window, the graphics device and the audio backend through the abstraction
         interfaces and gets the same host. It names no backend and no game title. -->
    <ProjectReference Include="..\..\Core\ProjectIGI.Core\ProjectIGI.Core.csproj" />
    <ProjectReference Include="..\ProjectIGI.Net.Udp\ProjectIGI.Net.Udp.csproj" />
    <ProjectReference Include="..\ProjectIGI.Net.WebRtc\ProjectIGI.Net.WebRtc.csproj" />
    <ProjectReference Include="..\ProjectIGI.Engine\ProjectIGI.Engine.csproj" />
    <ProjectReference Include="..\..\Core\ProjectIGI.Formats\ProjectIGI.Formats.csproj" />
    <ProjectReference Include="..\..\Core\ProjectIGI.Scripting\ProjectIGI.Scripting.csproj" />
    <ProjectReference Include="..\..\Game\ProjectIGI.Game\ProjectIGI.Game.csproj" />
    <ProjectReference Include="..\ProjectIGI.Modding\ProjectIGI.Modding.csproj" />
    <ProjectReference Include="..\..\Game\ProjectIGI.Presentation\ProjectIGI.Presentation.csproj" />
    <ProjectReference Include="..\..\Game\ProjectIGI.Frontend\ProjectIGI.Frontend.csproj" />
    <ProjectReference Include="..\..\UI\ProjectIGI.UI\ProjectIGI.UI.csproj" />
    <ProjectReference Include="..\..\Rendering\ProjectIGI.Rendering\ProjectIGI.Rendering.csproj" />
    <ProjectReference Include="..\..\Audio\ProjectIGI.Audio\ProjectIGI.Audio.csproj" />
    <ProjectReference Include="..\..\Platform\ProjectIGI.Input\ProjectIGI.Input.csproj" />
    <ProjectReference Include="..\..\Platform\ProjectIGI.Platform\ProjectIGI.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emits the [CVarContainer] registrations. Build-time only: nothing of it ships. -->
    <ProjectReference Include="..\..\Core\ProjectIGI.Generators\ProjectIGI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
