<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\ProjectIGI.Core\ProjectIGI.Core.csproj" />
    <ProjectReference Include="..\ProjectIGI.Engine\ProjectIGI.Engine.csproj" />
    <ProjectReference Include="..\..\Game\ProjectIGI.Game\ProjectIGI.Game.csproj" />
    <ProjectReference Include="..\..\Core\ProjectIGI.Scripting\ProjectIGI.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The modding API's surface, frozen: a change to a public member is a change mods see, so it is written down
         in PublicAPI.Unshipped.txt (moved to Shipped when a version ships) or the build fails. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
