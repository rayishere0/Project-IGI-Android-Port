+        {
+            SubpassDescription subpass = new()
+            {
+                PipelineBindPoint = PipelineBindPoint.Graphics,
+                ColorAttachmentCount = (uint)colourCount,
+                PColorAttachments = colourCount > 0 ? firstColour : null,
