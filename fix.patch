+            attachments[i] = new AttachmentDescription
+            {
+                Format = key.Colours[i],
+                Samples = (SampleCountFlags)key.Samples,
+                LoadOp = key.Loads[i],
+                StoreOp = key.Stores[i],
+                StencilLoadOp = LoadOp.DontCare,
+                StencilStoreOp = StoreOp.DontCare,
